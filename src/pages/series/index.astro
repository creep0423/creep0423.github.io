---
import { ArrowRight } from '@lucide/astro';
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSeriesWithPosts } from '@/lib/series';
import { withBase } from '@/lib/url';

const allSeries = await getSeriesWithPosts();

const description =
  'Multi-part article series that build on each other, from first principles to a working implementation.';
---

<BaseLayout title="Series" description={description}>
  <PageHero title="Series" description={description} motif="series" />

  <div class="container-page">
    {allSeries.length > 0 ? (
      <ul class="grid gap-5 md:grid-cols-2">
        {allSeries.map((series) => {
          const href = withBase(`/series/${series.slug}/`);
          const count = series.posts.length;
          // Built as a single string so a line break cannot swallow the space.
          const countLabel = `${count} ${count === 1 ? 'article' : 'articles'}`;

          return (
            <li class="h-full">
              {/* Same cool card surface as the project cards: the series grid is
                  the one other place cards carry the brand light. */}
              <article class="card-cool flex h-full flex-col rounded-lg border border-line bg-surface/60 p-6 transition-colors hover:border-accent/40 hover:bg-surface">
                <h2 class="text-lg leading-snug font-semibold tracking-tight text-ink">
                  <a href={href} class="rounded-sm transition-colors hover:text-accent">
                    {series.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-muted text-pretty">
                  {series.description}
                </p>

                <p class="mt-5 text-xs text-muted">{countLabel}</p>

                <a
                  href={href}
                  class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-medium text-ink transition-colors hover:text-accent"
                >
                  <span>View series</span>
                  <ArrowRight class="h-4 w-4" aria-hidden="true" />
                </a>
              </article>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="mt-10 border-t border-line py-10 text-sm text-muted">No series published yet.</p>
    )}
  </div>
</BaseLayout>
