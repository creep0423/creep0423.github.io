---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSeriesWithPosts } from '@/lib/series';
import { withBase } from '@/lib/url';

const allSeries = await getSeriesWithPosts();

const description =
  'Multi-part article series that build on each other, from first principles to a working implementation.';
---

<BaseLayout title="Series" description={description}>
  <div class="container-page pt-14 sm:pt-20">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Series</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">{description}</p>
    </header>

    {allSeries.length > 0 ? (
      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {allSeries.map((series) => {
          const href = withBase(`/series/${series.slug}/`);
          const count = series.posts.length;
          // Built as a single string so a line break cannot swallow the space.
          const countLabel = `${count} ${count === 1 ? 'article' : 'articles'}`;

          return (
            <li class="h-full">
              <article class="flex h-full flex-col rounded-xl border border-line bg-surface/60 p-6 transition-colors hover:border-accent/40">
                <h2 class="text-base font-semibold tracking-tight text-ink">
                  <a href={href} class="rounded-sm transition-colors hover:text-accent">
                    {series.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-muted">{series.description}</p>

                <p class="mt-5 text-xs text-muted">{countLabel}</p>

                <a
                  href={href}
                  class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-medium text-ink transition-colors hover:text-accent"
                >
                  <span>View series</span>
                  <ArrowRight class="h-4 w-4" aria-hidden="true" />
                </a>
              </article>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="mt-12 border-t border-line py-10 text-sm text-muted">No series published yet.</p>
    )}
  </div>
</BaseLayout>
