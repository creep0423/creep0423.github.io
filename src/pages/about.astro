---
import { Mail } from '@lucide/astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import PageHero from '@/components/PageHero.astro';
import Tag from '@/components/Tag.astro';
import { ABOUT, SITE } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/url';

const description = `About ${SITE.author} — ${SITE.jobTitle.toLowerCase()} working on large language models, retrieval-augmented generation and AI agents.`;
---

<BaseLayout title="About" description={description}>
  <PageHero title="About" description={SITE.jobTitle} motif="about" />

  <div class="container-page">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]">
      <div class="max-w-2xl">
        <section aria-labelledby="about-bio">
          <h2 id="about-bio" class="text-xl font-semibold tracking-tight">
            Introduction
          </h2>
          <div class="mt-4 space-y-4 text-base leading-relaxed text-muted">
            {ABOUT.bio.map((paragraph) => (
              <p class="text-pretty">{paragraph}</p>
            ))}
          </div>
        </section>

        <section class="mt-14" aria-labelledby="about-focus">
          <h2 id="about-focus" class="text-xl font-semibold tracking-tight">
            What I work on
          </h2>
          <ul class="mt-5 space-y-6">
            {ABOUT.focus.map((area) => (
              <li>
                <h3 class="text-base font-medium text-ink">{area.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted text-pretty">
                  {area.description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <div class="space-y-12">
        <section aria-labelledby="about-skills">
          <h2 id="about-skills" class="text-xl font-semibold tracking-tight">
            Skills
          </h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {ABOUT.skills.map((skill) => (
              <li>
                <Tag tag={skill} link={false} />
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="about-contact">
          <h2 id="about-contact" class="text-xl font-semibold tracking-tight">
            Get in touch
          </h2>
          <ul class="mt-4 space-y-3 text-sm">
            <li>
              <a
                href={SITE.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-md text-muted transition-colors hover:text-ink"
              >
                <GitHubIcon class="h-4 w-4" />
                <span>{SITE.github.replace(/^https?:\/\//, '')}</span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
            <li>
              <a
                href={`mailto:${SITE.email}`}
                class="inline-flex items-center gap-2 rounded-md text-muted transition-colors hover:text-ink"
              >
                <Mail class="h-4 w-4" aria-hidden="true" />
                <span>{SITE.email}</span>
              </a>
            </li>
          </ul>

          <p class="mt-6 text-sm leading-relaxed text-muted text-pretty">
            可以通过{' '}
            <a href={withBase('/rss.xml')} class="link-subtle hover:text-ink">
              RSS
            </a>{' '}
            订阅新文章。如果发现内容中的错误，或有任何想法与建议，欢迎通过 Email 或 GitHub Issue
            与我交流。
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
