---
import { ArrowRight } from '@lucide/astro';
import BlogCard from '@/components/BlogCard.astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Tag from '@/components/Tag.astro';
import { ABOUT, SITE } from '@/config';
import { featuredProjects } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFeaturedPosts } from '@/lib/posts';
import { withBase } from '@/lib/url';

// Featured posts only; drafts are filtered out inside `getFeaturedPosts()`.
const posts = await getFeaturedPosts(5);
const focusPreview = ABOUT.focus.slice(0, 4);

const primaryButton =
  'inline-flex items-center gap-2 rounded-md bg-ink px-4 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-90';
const secondaryButton =
  'inline-flex items-center gap-2 rounded-md border border-line px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:bg-surface';
---

<BaseLayout>
  <section class="container-page pt-16 pb-2 sm:pt-24">
    <p class="text-sm font-medium text-muted">{SITE.jobTitle}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Hi, I'm {SITE.author} 👋</h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{SITE.tagline}</p>

    <ul class="mt-7 flex flex-wrap gap-2">
      {SITE.techTags.map((technology) => (
        <li>
          <Tag tag={technology} link={false} />
        </li>
      ))}
    </ul>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href={withBase('/blog/')} class={primaryButton}>
        <span>View blog</span>
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class={secondaryButton}>
        <GitHubIcon class="h-4 w-4" />
        <span>GitHub</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </section>

  <section class="container-page mt-20 sm:mt-28" aria-labelledby="featured-articles">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="featured-articles" class="text-lg font-semibold tracking-tight">
        Featured Articles
      </h2>
      <a
        href={withBase('/blog/')}
        class="rounded-md text-sm text-muted transition-colors hover:text-ink"
      >
        All articles →
      </a>
    </div>

    {posts.length > 0 ? (
      <ul class="mt-6 divide-y divide-line border-t border-line">
        {posts.map((post) => (
          <li class="py-7">
            {/* The section heading already says "Featured Articles", so the
                per-card badge would only repeat itself here. */}
            <BlogCard post={post} showSeries showFeaturedBadge={false} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 border-t border-line py-10 text-sm text-muted">No featured articles yet.</p>
    )}
  </section>

  <section class="container-page mt-20 sm:mt-28" aria-labelledby="featured-projects">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="featured-projects" class="text-lg font-semibold tracking-tight">
        Featured projects
      </h2>
      <a
        href={withBase('/projects/')}
        class="rounded-md text-sm text-muted transition-colors hover:text-ink"
      >
        All projects →
      </a>
    </div>

    <ul class="mt-6 grid gap-5 md:grid-cols-3">
      {featuredProjects.map((project) => (
        <li class="h-full">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page mt-20 sm:mt-28" aria-labelledby="about-preview">
    <h2 id="about-preview" class="text-lg font-semibold tracking-tight">
      About
    </h2>

    <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
      <div>
        <p class="max-w-2xl text-base leading-relaxed text-muted">{ABOUT.bio[0]}</p>
        <a
          href={withBase('/about/')}
          class="mt-6 inline-flex items-center gap-1.5 rounded-md text-sm font-medium text-ink transition-colors hover:text-accent"
        >
          <span>More about me</span>
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </div>

      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {focusPreview.map((area) => (
          <li>
            <h3 class="text-sm font-medium text-ink">{area.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">{area.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
