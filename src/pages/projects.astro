---
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';

const description =
  'Selected AI engineering projects: a retrieval-augmented generation pipeline, a tool-calling agent and an LLM experimentation playground.';
---

<BaseLayout title="Projects" description={description}>
  <PageHero
    title="Projects"
    description="Things I have built to understand how large language model systems behave in practice — each one is small enough to read end to end."
    motif="projects"
  />

  <div class="container-page">
    <ul class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => (
        <li class="h-full">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
