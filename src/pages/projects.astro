---
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';

const description =
  'Selected AI engineering projects: a retrieval-augmented generation pipeline, a tool-calling agent and an LLM experimentation playground.';
---

<BaseLayout title="Projects" description={description}>
  <PageHero
    title="Projects"
    description="展示围绕大模型、RAG 与 AI Agent 做的一些项目，把想法落成可运行的东西，也记录其中的限制、取舍与改进。"
    motif="projects"
  />

  <div class="container-page">
    <ul class="grid gap-5 md:grid-cols-2">
      {projects.map((project) => (
        <li class="h-full">
          <ProjectCard project={project} />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
