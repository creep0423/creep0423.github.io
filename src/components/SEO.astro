---
import { SITE } from '@/config';
import { absoluteUrl } from '@/lib/url';

interface Props {
  /** Page title, rendered as `<title>{title} | {SITE.title}</title>`. */
  title?: string;
  description?: string;
  /** Social preview image, relative to `public/`. Defaults to `SITE.ogImage`. */
  image?: string;
  /** Open Graph object type. */
  type?: 'website' | 'article';
  /** ISO publication date, used when `type` is `article`. */
  publishedTime?: string;
  /** ISO modification date, used when `type` is `article`. */
  modifiedTime?: string;
  /** Article tags, emitted as `article:tag`. */
  tags?: string[];
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.jobTitle}`;
// `Astro.url` already contains the configured base path, so it is joined with
// the site origin directly rather than passed through `withBase()`.
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const socialImage = image ? absoluteUrl(image, Astro.site) : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta name="author" content={SITE.author} />
<meta name="generator" content={Astro.generator} />
{type === 'website' && <meta name="keywords" content={SITE.keywords.join(', ')} />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.locale} />
{socialImage && <meta property="og:image" content={socialImage} />}
{socialImage && <meta property="og:image:alt" content={`${SITE.title} — ${SITE.tagline}`} />}
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && <meta property="article:author" content={SITE.author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}
