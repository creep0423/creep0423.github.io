---
import { ArrowUpRight } from '@lucide/astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import Tag from '@/components/Tag.astro';
import type { Project } from '@/data/projects';
import { getProjectLinks } from '@/lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const links = getProjectLinks(project);
---

<article class="card-cool flex h-full flex-col rounded-lg border border-line bg-surface/60 p-6 transition-colors hover:border-accent/40 hover:bg-surface">
  <header class="flex items-baseline justify-between gap-4">
    <h3 class="text-lg leading-snug font-semibold tracking-tight text-ink">{project.title}</h3>
    <span class="text-xs tabular-nums text-muted">{project.year}</span>
  </header>

  <p class="mt-3 text-sm leading-relaxed text-muted text-pretty">{project.description}</p>

  {project.highlights.length > 0 && (
    <ul class="mt-4 space-y-1.5 text-sm text-muted">
      {project.highlights.map((highlight) => (
        <li class="flex gap-2.5">
          {/* Decorative marker: muted, so the accent stays reserved for links. */}
          <span aria-hidden="true" class="text-muted/70">
            –
          </span>
          <span>{highlight}</span>
        </li>
      ))}
    </ul>
  )}

  <ul class="mt-5 flex flex-wrap gap-2">
    {project.technologies.map((technology) => (
      <li>
        <Tag tag={technology} link={false} />
      </li>
    ))}
  </ul>

  {links.length > 0 && (
    <ul class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-6 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="inline-flex items-center gap-1.5 rounded-md text-muted transition-colors hover:text-ink"
          >
            {link.label === 'Source code' ? (
              <GitHubIcon class="h-4 w-4" />
            ) : (
              <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
            )}
            <span>{link.label}</span>
            {link.external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
</article>
