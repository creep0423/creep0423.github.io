---
/**
 * Inner page hero, lite.
 *
 * A real, self-contained cover section for the four main inner pages (Blog,
 * Series, Projects, About). It carries the same brand light as the homepage hero
 * at roughly half the weight: ambient washes that fade back into the canvas on
 * every side, the page title with the site's short accent rule, and a small,
 * symbolic drawing on the right.
 *
 * Deliberately narrow: a title, a description and one motif selector. No
 * eyebrow, call to action, tags, icon, image or slot system — the homepage hero
 * stays the only place with those.
 */
type Motif = 'blog' | 'series' | 'projects' | 'about';

interface Props {
  /** Page title, rendered as the page `<h1>`. */
  title: string;
  /** One or two lines of muted copy under the title. */
  description: string;
  /**
   * Which drawing the hero shows on the right. All four share one geometry
   * (same box, stroke width, node radii, dot style, colour and opacity); only
   * the nodes and their connections differ, so each page gets its own structure
   * without leaving the family.
   */
  motif: Motif;
}

const { title, description, motif } = Astro.props;
---

{/*
  `pt` gives the cover its height, `pb` is the gap before the page content; both
  are fixed here so all four pages share one rhythm. The washes and the motif are
  decoration only and never take part in layout.
*/}
<header class="page-hero-lite pt-10 pb-8 sm:pt-14 sm:pb-12">
  <div class="container-page relative">
    {/*
      The drawing. One shared frame — the same 190×96 box, 1px rounded strokes,
      2.2–2.8px nodes, 1.2px neutral marks and the same two colour tokens — with
      only the inner structure switched per page:

        blog     two sources converging into one node, then out again
        series   one continuous path stepping across the box
        projects a pipeline through two small outlined modules
        about    a single core with branches in every direction

      Hidden below `lg`, where it would sit on top of the description.
    */}
    <svg
      class="page-hero-lite-motif pointer-events-none absolute top-1/2 right-0 hidden h-auto w-[13rem] -translate-y-1/2 lg:block"
      viewBox="0 0 190 96"
      fill="none"
      stroke-width="1"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      {motif === 'blog' && (
        <>
          {/* Aggregation: two sources in, one result, two outputs. */}
          <g stroke="currentColor">
            <path d="M14 26 L74 48 M14 70 L74 48 M74 48 H128 M128 48 L174 26 M128 48 L174 70" />
          </g>
          <g fill="currentColor" stroke="none">
            <circle cx="14" cy="26" r="2.2" />
            <circle cx="14" cy="70" r="2.2" />
            <circle cx="74" cy="48" r="2.8" />
            <circle cx="128" cy="48" r="2.4" />
            <circle cx="174" cy="26" r="2.2" />
            <circle cx="174" cy="70" r="2.2" />
          </g>
          <g class="is-neutral" fill="currentColor" stroke="none">
            <circle cx="46" cy="10" r="1.2" />
            <circle cx="100" cy="84" r="1.2" />
            <circle cx="152" cy="14" r="1.2" />
            <circle cx="26" cy="90" r="1.2" />
          </g>
        </>
      )}

      {motif === 'series' && (
        <>
          {/* Progression: one path stepping across the box, then dropping off. */}
          <g stroke="currentColor">
            <path d="M12 66 L58 42 M58 42 L106 62 M106 62 L152 38 M152 38 L180 68" />
          </g>
          <g fill="currentColor" stroke="none">
            <circle cx="12" cy="66" r="2.2" />
            <circle cx="58" cy="42" r="2.4" />
            <circle cx="106" cy="62" r="2.4" />
            <circle cx="152" cy="38" r="2.8" />
            <circle cx="180" cy="68" r="2.2" />
          </g>
          <g class="is-neutral" fill="currentColor" stroke="none">
            <circle cx="34" cy="84" r="1.2" />
            <circle cx="82" cy="16" r="1.2" />
            <circle cx="130" cy="86" r="1.2" />
            <circle cx="168" cy="14" r="1.2" />
          </g>
        </>
      )}

      {motif === 'projects' && (
        <>
          {/* System: a pipeline running node → module → node → module. */}
          <g stroke="currentColor">
            <rect x="40" y="23" width="32" height="22" rx="4" />
            <rect x="126" y="52" width="30" height="20" rx="4" />
            <path d="M12 34 H40 M72 34 H100 M100 34 L126 62 M156 62 H174" />
          </g>
          <g fill="currentColor" stroke="none">
            <circle cx="12" cy="34" r="2.2" />
            <circle cx="100" cy="34" r="2.6" />
            <circle cx="174" cy="62" r="2.2" />
          </g>
          <g class="is-neutral" fill="currentColor" stroke="none">
            <circle cx="30" cy="80" r="1.2" />
            <circle cx="86" cy="12" r="1.2" />
            <circle cx="168" cy="20" r="1.2" />
            <circle cx="104" cy="84" r="1.2" />
          </g>
        </>
      )}

      {motif === 'about' && (
        <>
          {/* Constellation: one core, branches in every direction, loosest of
              the four, with a few more marks around it. */}
          <g stroke="currentColor">
            <path d="M74 48 L26 22 M74 48 L128 26 M74 48 L152 68 M74 48 L46 82" />
          </g>
          <g fill="currentColor" stroke="none">
            <circle cx="74" cy="48" r="2.8" />
            <circle cx="26" cy="22" r="2.2" />
            <circle cx="128" cy="26" r="2.2" />
            <circle cx="152" cy="68" r="2.2" />
            <circle cx="46" cy="82" r="2.2" />
          </g>
          <g class="is-neutral" fill="currentColor" stroke="none">
            <circle cx="12" cy="52" r="1.2" />
            <circle cx="60" cy="10" r="1.2" />
            <circle cx="108" cy="10" r="1.2" />
            <circle cx="176" cy="38" r="1.2" />
            <circle cx="110" cy="88" r="1.2" />
            <circle cx="20" cy="90" r="1.2" />
          </g>
        </>
      )}
    </svg>

    <h1 class="page-hero-lite-title text-3xl leading-tight font-semibold tracking-tight sm:text-4xl">
      {title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted text-pretty">{description}</p>
  </div>
</header>
