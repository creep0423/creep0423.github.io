---
import 'katex/dist/katex.min.css';
import '@/styles/article.css';

import { ArrowLeft, ArrowRight, CalendarDays, Clock, Layers, RefreshCw } from '@lucide/astro';
import type { MarkdownHeading } from 'astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Tag from '@/components/Tag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { BlogPost } from '@/lib/posts';
import type { SeriesContext } from '@/lib/series';
import { withBase } from '@/lib/url';
import { formatDate, getReadingTimeMinutes, toISODate } from '@/lib/utils';

interface Props {
  post: BlogPost;
  /** Heading tree extracted from the rendered Markdown. */
  headings: MarkdownHeading[];
  /** The next newer post, when one exists. */
  newer?: BlogPost;
  /** The next older post, when one exists. */
  older?: BlogPost;
  /** Series the post belongs to; `null` when it is not part of a known series. */
  series?: SeriesContext | null;
}

const { post, headings, newer, older, series } = Astro.props;
const { title, description, pubDate, updatedDate, tags, category } = post.data;

const readingTime = getReadingTimeMinutes(post.body);
const backHref = withBase('/blog/');

const seriesHref = series ? withBase(`/series/${series.slug}/`) : null;
const partNumber = series ? series.index + 1 : 0;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={toISODate(pubDate)}
  modifiedTime={updatedDate ? toISODate(updatedDate) : undefined}
  tags={tags}
>
  <div class="container-page pt-10 sm:pt-12">
    {/*
      At `lg` the whole reading composition — the prose column, the gutter and the
      table of contents — is centred as one group (44rem + 3rem + 15rem = 62rem).
      Without that the sidebar pins the column to the left edge and leaves a wide
      strip of empty space beside it.

      The header sits inside the grid's first column rather than above the grid,
      so its measure can never drift away from the body's.
    */}
    <div class="lg:mx-auto lg:max-w-[62rem]">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_15rem]">
        <div class="min-w-0">
          <article class="container-prose mx-auto lg:mx-0">
            <a
              href={backHref}
              class="inline-flex items-center gap-1.5 rounded-md text-sm text-muted transition-colors hover:text-accent"
            >
              <ArrowLeft class="h-4 w-4" aria-hidden="true" />
              <span>All articles</span>
            </a>

            {/* The header picks up a wash at roughly a third of the inner page
                hero: enough to read as a lit area rather than raw text, far too
                little to compete with the title. */}
            <header class="article-head mt-8">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted">
                <span class="inline-flex items-center gap-1.5">
                  <CalendarDays class="h-3.5 w-3.5" aria-hidden="true" />
                  <time datetime={toISODate(pubDate)}>{formatDate(pubDate)}</time>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <Clock class="h-3.5 w-3.5" aria-hidden="true" />
                  <span class="tabular-nums">{readingTime} min read</span>
                </span>
                <span>{category}</span>
                {updatedDate && (
                  <span class="inline-flex items-center gap-1.5">
                    <RefreshCw class="h-3.5 w-3.5" aria-hidden="true" />
                    <span>
                      Updated{' '}
                      <time datetime={toISODate(updatedDate)}>{formatDate(updatedDate)}</time>
                    </span>
                  </span>
                )}
              </div>

              {/* `leading-snug` rather than `leading-tight`: the titles here are
                  often two lines of Chinese, which needs more room than Latin. */}
              <h1 class="mt-4 text-3xl leading-snug font-semibold tracking-tight sm:text-4xl">
                {title}
              </h1>

              <p class="mt-4 text-base leading-relaxed text-muted text-pretty sm:text-lg">
                {description}
              </p>

              {tags.length > 0 && (
                <ul class="mt-6 flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <li>
                      <Tag tag={tag} />
                    </li>
                  ))}
                </ul>
              )}

              {/*
                Only rendered for posts that belong to a known series, so ordinary
                posts keep exactly the same header. A rail, a mark and a faint
                surface: enough to read as "you are inside a series" at a glance,
                without becoming a card.
              */}
              {series && seriesHref && (
                <p class="article-series-context mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 rounded-r-md border-l-2 py-2 pr-3 pl-2.5 text-xs text-muted">
                  <Layers class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                  <a
                    href={seriesHref}
                    class="rounded-sm font-medium text-ink transition-colors hover:text-[var(--hero-accent)]"
                  >
                    {series.title}
                  </a>
                  <span aria-hidden="true">·</span>
                  <span class="tabular-nums">
                    Part {partNumber} of {series.posts.length}
                  </span>
                </p>
              )}
            </header>

            {/* Collapsible table of contents on small screens; the sidebar version
                is rendered below and shown from `lg` upwards. */}
            <details class="mt-10 rounded-lg border border-line px-4 py-3 lg:hidden">
              <summary class="cursor-pointer text-sm font-medium text-ink">On this page</summary>
              <div class="mt-3">
                <TableOfContents headings={headings} />
              </div>
            </details>
          </article>

          <div class="article-body container-prose mx-auto mt-10 lg:mx-0" data-article-body>
            <slot />
          </div>

          {/*
            Series navigation, for posts that belong to a series. One light
            surface holding the reading context and the two neighbours as plain
            entries — no card nested inside a card. Chronological navigation is
            deliberately not rendered for these posts: it would point at the very
            same articles and leave the reader choosing between two systems.
            Posts outside a series do not render this block at all.
          */}
          {series && seriesHref && (
            <section
              class="article-series-nav container-prose mx-auto mt-14 rounded-lg border border-line px-5 py-[1.125rem] lg:mx-0"
              aria-labelledby="series-navigation-heading"
            >
              <h2
                id="series-navigation-heading"
                class="text-xs font-semibold tracking-wide text-muted uppercase"
              >
                In this series
              </h2>

              <p class="mt-1.5 text-sm text-muted">
                <a
                  href={seriesHref}
                  class="font-medium text-ink transition-colors hover:text-[var(--hero-accent)]"
                >
                  {series.title}
                </a>
                <span aria-hidden="true"> · </span>
                <span class="tabular-nums">
                  Part {partNumber} of {series.posts.length}
                </span>
              </p>

              {(series.previous || series.next) && (
                <ul
                  class:list={[
                    'mt-3.5 grid gap-3.5 border-t border-line pt-3.5',
                    // Two columns only when there are two entries, so a lone
                    // neighbour never leaves an empty half behind.
                    series.previous && series.next && 'sm:grid-cols-2 sm:gap-6',
                  ]}
                >
                  {series.previous && (
                    <li>
                      <a
                        href={withBase(`/blog/${series.previous.id}/`)}
                        class="group flex flex-col rounded-md"
                      >
                        <span class="inline-flex items-center gap-1.5 text-xs leading-none text-muted/80">
                          <ArrowLeft class="h-3 w-3" aria-hidden="true" />
                          Previous
                        </span>
                        <span class="mt-1.5 text-sm leading-snug font-medium text-ink transition-colors group-hover:text-[var(--hero-accent)]">
                          {series.previous.data.title}
                        </span>
                      </a>
                    </li>
                  )}
                  {series.next && (
                    <li class="sm:text-right">
                      <a
                        href={withBase(`/blog/${series.next.id}/`)}
                        class="group flex flex-col rounded-md"
                      >
                        <span class="inline-flex items-center gap-1.5 text-xs leading-none text-muted/80 sm:justify-end">
                          Next
                          <ArrowRight class="h-3 w-3" aria-hidden="true" />
                        </span>
                        <span class="mt-1.5 text-sm leading-snug font-medium text-ink transition-colors group-hover:text-[var(--hero-accent)]">
                          {series.next.data.title}
                        </span>
                      </a>
                    </li>
                  )}
                </ul>
              )}
            </section>
          )}

          <nav
            class="container-prose mx-auto mt-14 border-t border-line pt-8 lg:mx-0"
            aria-label="Post navigation"
          >
            {/* Chronological neighbours: only for posts outside a series, and
                again only two columns when both exist. */}
            {!series && (older || newer) && (
              <ul class:list={['grid gap-4', older && newer && 'sm:grid-cols-2']}>
                {older && (
                  <li>
                    <a
                      href={withBase(`/blog/${older.id}/`)}
                      class="article-nav-card flex h-full flex-col rounded-lg border border-line p-4 transition-colors"
                    >
                      <span class="inline-flex items-center gap-1.5 text-xs leading-none text-muted/80">
                        <ArrowLeft class="h-3 w-3" aria-hidden="true" />
                        Older
                      </span>
                      <span class="article-nav-title mt-1.5 text-sm leading-snug font-medium text-ink">
                        {older.data.title}
                      </span>
                    </a>
                  </li>
                )}
                {newer && (
                  <li class="sm:text-right">
                    <a
                      href={withBase(`/blog/${newer.id}/`)}
                      class="article-nav-card flex h-full flex-col rounded-lg border border-line p-4 transition-colors"
                    >
                      <span class="inline-flex items-center gap-1.5 text-xs leading-none text-muted/80 sm:justify-end">
                        Newer
                        <ArrowRight class="h-3 w-3" aria-hidden="true" />
                      </span>
                      <span class="article-nav-title mt-1.5 text-sm leading-snug font-medium text-ink">
                        {newer.data.title}
                      </span>
                    </a>
                  </li>
                )}
              </ul>
            )}

            <div class:list={[!series && (older || newer) && 'mt-8']}>
              <a
                href={backHref}
                class="inline-flex items-center gap-1.5 rounded-md text-sm text-muted transition-colors hover:text-accent"
              >
                <ArrowLeft class="h-4 w-4" aria-hidden="true" />
                <span>Back to all articles</span>
              </a>
            </div>
          </nav>
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <p class="toc-heading text-xs font-semibold tracking-wide text-ink uppercase">
              On this page
            </p>
            <div class="mt-3">
              <TableOfContents headings={headings} />
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>
